# Variáveis de ambiente para os testes e2e com Playwright
# Copie este arquivo para .env e preencha com as credenciais do Keycloak

# Must be a tenant admin (member of a /tenant/<slug> Keycloak group, "admin" realm role) — this is
# what almost every spec in the suite assumes.
E2E_USER=seu_usuario_keycloak
E2E_PASSWORD=sua_senha_keycloak

# Optional — only needed for the cross-tenant /api/admin/* describe blocks (e.g. in
# e2e/academies.spec.ts). Must be a Keycloak user with NO /tenant/* group membership plus the
# "admin" realm role (the frontend AuthGuard requires "admin" or "manager" to load the app at all,
# separately from the backend's tenant-less-membership superadmin check).
E2E_SUPERADMIN_USER=
E2E_SUPERADMIN_PASSWORD=
