{
  "name": "jiu-admin",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate:api1": "openapi-generator-cli generate -i http://localhost:8080/openapi/v1.json -g typescript-angular -o ./src/app/generated_services/ --skip-validate-spec --additional-properties=ngVersion=18.2.5,supportsES6=true,npmVersion=10.3.0,withInterfaces=true,basePath=http://localhost:8080",
    "generate:api2": "openapi-generator-cli generate -i http://localhost:8003/openapi.json -g typescript-angular -o ./src/app/generated_services/api2 --additional-properties=ngVersion=18.2.5,supportsES6=true,npmVersion=10.3.0,withInterfaces=true,basePath=http://localhost:8003",
    "generate:all": "npm run generate:api1 && npm run generate:api2",
    "e2e": "node --env-file=e2e/.env node_modules/.bin/playwright test",
    "e2e:ui": "node --env-file=e2e/.env node_modules/.bin/playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.19",
    "@angular/common": "^20.3.19",
    "@angular/compiler": "^20.3.19",
    "@angular/core": "^20.3.19",
    "@angular/forms": "^20.3.19",
    "@angular/localize": "20.3.19",
    "@angular/platform-browser": "^20.3.19",
    "@angular/platform-browser-dynamic": "^20.3.19",
    "@angular/router": "^20.3.19",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@popperjs/core": "2.11.8",
    "bootstrap": "^5.3.8",
    "echarts": "^6.0.0",
    "highcharts": "^12.1.2",
    "jwt-decode": "^4.0.0",
    "keycloak-angular": "^20.1.0",
    "keycloak-js": "^26.2.3",
    "luxon": "^3.5.0",
    "ng-openapi-gen": "^0.52.0",
    "ngx-echarts": "^19.0.0",
    "ngx-toastr": "^19.1.0",
    "primeicons": "^7.0.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.24",
    "@angular/cli": "^20.3.24",
    "@angular/compiler-cli": "^20.3.19",
    "@openapitools/openapi-generator-cli": "^2.15.0",
    "@playwright/test": "^1.60.0",
    "@types/jasmine": "~4.3.0",
    "@types/jquery": "^3.5.9",
    "@types/luxon": "^3.4.2",
    "dotenv": "^17.4.2",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nswag": "^14.1.0",
    "rxjs": "^7.8.1",
    "typescript": "~5.9.3"
  }
}
